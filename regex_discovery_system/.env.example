# AWS — set your named profile for local dev; leave EMPTY on EC2/ECS (uses instance role)
AWS_PROFILE=
AWS_REGION=us-east-1

# Tavily web-search API key (optional — falls back to DuckDuckGo)
TAVILY_API_KEY=

# Rotating proxies for Camoufox stealth browser (comma-separated, optional)
# Format: http://user:pass@host:port,http://user:pass@host2:port
PROXIES=
