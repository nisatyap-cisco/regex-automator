=BC=CF=8C=CF=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=
=83=CE=B7=CF=82|\#?=CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=BA=CE=AE=
=CF=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=
=CF=82|=CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=BA=CE=AE =CE=B4=CF=81=
=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7|\#? =CE=B4=CF=81=CE=
=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82|=CE=B1=CF=81. =CE=
=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82|y[=C3=
=B6o]nlendirme numaras[=C4=B1i]|banka y[=C3=B6o]nlendirme no|banka y[=C3=B6=
o]nlendirme|y[=C3=B6o]nlendirme no.|y[=C3=B6o]nlendirme\#?|y[=C3=B6o]n. no.=
|RTN)(?:\b|(?&lt;=3D[.#])(?=3D\W|$))</td>
</tr>
<tr>
