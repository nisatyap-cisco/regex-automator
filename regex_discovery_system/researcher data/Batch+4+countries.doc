<td colspan=3D"1" class=3D"confluenceTd">(?i)(?:vat =E7=B7=A8=E8=99=9F|vat =
=E8=99=9F=E7=A2=BC|=E5=8A=A0=E5=80=BC=E7=A8=85=E7=B7=A8=E8=99=9F|=E5=8A=A0=
=E5=80=BC=E7=A8=85|vat =E8=99=9F|vat\#?|VAT)(?:\b|(?&lt;=3D[.#])(?=3D\W|$))=
</td>
