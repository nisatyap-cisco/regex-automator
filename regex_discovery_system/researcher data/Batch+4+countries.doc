=CF=82 =CE=AC=CE=B4=CE=B5=CE=B9=CE=B1=CF=82, =CE=B1=CF=81=CE=B9=CE=B8=CE=BC=
=CF=8C=CF=82 =CE=BA=CF=85=CE=BA=CE=BB=CE=BF=CF=86=CE=BF=CF=81=CE=AF=CE=B1=
=CF=82, =CF=80=CE=B9=CE=BD=CE=B1=CE=BA=CE=AF=CE=B4=CE=B1 =CE=BA=CF=85=CE=BA=
=CE=BB=CE=BF=CF=86=CE=BF=CF=81=CE=AF=CE=B1=CF=82, =CE=B1=CF=81=CE=B9=CE=B8=
