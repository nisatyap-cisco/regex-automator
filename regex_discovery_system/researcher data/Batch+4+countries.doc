<tr>
<th class=3D"highlight-grey confluenceTh" data-highlight-colour=3D"grey" ro=
wspan=3D"2">Tax ID Number</th>
<td rowspan=3D"3" class=3D"confluenceTd">Nigeria Tax ID Number matches a va=
lid Tax Identification Number combined with any of the following keywords w=
ithin a proximity of 10 terms: tax identification number, tax identity numb=
er, tax number, tax identification code, tax file, tax identification no, t=
ax no#, tax no, tax registration number, tax id number, taxidnumber#, taxid=
number, taxidno#, taxidno, taxid#, taxid, taxno#, taxno, taxnumber#, taxnum=
ber, tax id, tin id, tin no, tin# (or) TIN.<span style=3D"color: rgb(23,43,=
77);">&nbsp;(All terms case insensitive.)</span></td>
<td class=3D"confluenceTd"><span style=3D"color: rgb(0,0,0);">(?:\d{10,14}|=
\d{8}-0001)</span></td>
<td rowspan=3D"3" class=3D"confluenceTd"><br></td>
</tr>
<tr>
<td class=3D"confluenceTd">(?i)(?:tax identification number|tax identity nu=
mber|tax number|tax identification code|tax file|tax identification no|tax =
no\#?|tax no|tax registration number|tax id number|taxidnumber\#?|taxidno\#=
?|taxid\#?|taxno\#?|taxnumber\#?|tax id|tin id|tin no|tin\#?|TIN)(?:\b|(?&l=
t;=3D[.#])(?=3D\W|$))</td>
