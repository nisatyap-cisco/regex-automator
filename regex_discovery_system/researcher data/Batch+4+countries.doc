=91i l=E1=BA=A1i qu=E1=BB=91c t=E1=BA=BF, chi ti=E1=BA=BFt h=E1=BB=99 chi=
=E1=BA=BFu, th=E1=BB=8B th=E1=BB=B1c, th=E1=BA=BB c=C4=83n c=C6=B0=E1=BB=9B=
c c=C3=B4ng d=C3=A2n, s=E1=BB=91 h=E1=BB=99 chi=E1=BA=BFu, gi=E1=BA=A5y t=
=E1=BB=9D =C4=91i l=E1=BA=A1i, c=C6=A1 quan c=E1=BA=A5p, gi=E1=BA=A5y t=E1=
=BB=9D t=C3=B9y th=C3=A2n, m=C3=A3 h=E1=BB=99 chi=E1=BA=BFu, s=E1=BB=91 h=
=E1=BB=99 chi=E1=BA=BFu, s=E1=BB=91 th=E1=BA=BB h=E1=BB=99 chi=E1=BA=BFu, n=
h=E1=BA=ADn d=E1=BA=A1ng (or) h=E1=BB=99 chi=E1=BA=BFu.<span style=3D"color=
: rgb(23,43,77);"><span>&nbsp;</span></span><span style=3D"color: rgb(23,43=
,77);">(All terms case insensitive; diacritics are optional.)</span></td>
