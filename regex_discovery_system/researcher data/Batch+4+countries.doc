=CE=B9=CE=B8=CE=BC=CF=8C=CF=82 =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=
=CF=83=CE=BC=CE=BF=CF=8D, =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=
=CE=BC=CF=8C=CF=82 =CE=BC=CE=B5 =CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C, banka=
 hesap numaras=C4=B1, banka bilgileri, banka numaras=C4=B1, hesap kodu, hes=
ap no, hes. numaras=C4=B1 (or) numaral=C4=B1 hesap.</td>
