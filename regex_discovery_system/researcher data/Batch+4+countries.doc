<tr>
<th class=3D"confluenceTh">National ID Number</th>
<td class=3D"confluenceTd">(?i)(?:NIN\#?|s[=E1=BB=91o] c[=C4=83a]n c[=C6=B0=
u][=E1=BB=9Bo]c c[=C3=B4o]ng d[=C3=A2a]n|s[=E1=BB=91o] c[=C4=83a]n c[=C6=B0=
u][=E1=BB=9Bo]c|s[=E1=BB=91o] ch[=E1=BB=A9u]ng minh th[=C6=B0u]|s[=E1=BB=91=
o] th[=E1=BA=BBe] c[=C4=83a]n c[=C6=B0u][=E1=BB=9Bo]c c[=C3=B4o]ng d[=C3=A2=
a]n|c[=C4=83a]n c[=C6=B0u][=E1=BB=9Bo]c c[=C3=B4o]ng d[=C3=A2a]n)(?:\b|(?&l=
t;=3D[.#])(?=3D\W|$))</td>
