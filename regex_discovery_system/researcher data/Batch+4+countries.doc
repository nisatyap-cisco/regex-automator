<td rowspan=3D"3" class=3D"confluenceTd"><br></td>
</tr>
<tr>
<td class=3D"confluenceTd">(?i)(?:sin\#?|Social Insurance Number|social ins=
urance no|social insurance|social ins|soc ins)(?:\b|(?&lt;=3D[.#])(?=3D\W|$=
))</td>
</tr>
<tr>
