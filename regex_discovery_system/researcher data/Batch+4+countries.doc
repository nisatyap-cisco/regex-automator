=BB=8A=E7=89=8C (or) =E8=BB=8A=E8=BC=9B=E7=99=BB=E8=A8=98=E8=99=9F=E7=A2=BC=
.</td>
<td class=3D"confluenceTd">[A-Z]{2,3}[-]?\d{2,4}|\d{3,4}[-]?[A-Z]{2,3}</td>
