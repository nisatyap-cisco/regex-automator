of the following keywords within a proximity of 10 terms: =CE=B1=CF=81=CE=
=B9=CE=B8=CE=BC=CF=8C=CF=82 =CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=
=BA=CE=BF=CF=8D =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=BC=CE=
=BF=CF=8D, =CF=83=CF=84=CE=BF=CE=B9=CF=87=CE=B5=CE=AF=CE=B1 =CF=84=CF=81=CE=
=AC=CF=80=CE=B5=CE=B6=CE=B1=CF=82, =CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C=CF=
=82 =CF=84=CF=81=CE=AC=CF=80=CE=B5=CE=B6=CE=B1=CF=82, =CE=BA=CF=89=CE=B4=CE=
=B9=CE=BA=CF=8C=CF=82 =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=
=BC=CE=BF=CF=8D, =CE=B1=CE=BD=CE=B1=CE=B3=CE=BD=CF=89=CF=81=CE=B9=CF=83=CF=
=84=CE=B9=CE=BA=CF=8C =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=
=BC=CE=BF=CF=8D, =CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C=CF=82 =CE=BB=CE=BF=CE=
=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=BC=CE=BF=CF=8D (or) =CE=BB=CE=BF=CE=B3=
=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=BC=CF=8C=CF=82 =CE=BC=CE=B5 =CE=B1=CF=81=
=CE=B9=CE=B8=CE=BC=CF=8C.</td>
<td style=3D"text-align: left;" class=3D"confluenceTd">\d{16}</td>
<td rowspan=3D"3" style=3D"text-align: left;" class=3D"confluenceTd"><br></=
td>
</tr>
<tr>
<td colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTd">(?i)(?=
:=CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C=CF=82 =CF=84=CF=81=CE=B1=CF=80=CE=B5=
=CE=B6=CE=B9=CE=BA=CE=BF=CF=8D =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=
=CF=83=CE=BC=CE=BF=CF=8D|=CF=83=CF=84=CE=BF=CE=B9=CF=87=CE=B5=CE=AF=CE=B1 =
=CF=84=CF=81=CE=AC=CF=80=CE=B5=CE=B6=CE=B1=CF=82|=CE=B1=CF=81=CE=B9=CE=B8=
=CE=BC=CF=8C=CF=82 =CF=84=CF=81=CE=AC=CF=80=CE=B5=CE=B6=CE=B1=CF=82|=CE=BA=
=CF=89=CE=B4=CE=B9=CE=BA=CF=8C=CF=82 =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=
=CE=B1=CF=83=CE=BC=CE=BF=CF=8D|=CE=B1=CE=BD=CE=B1=CE=B3=CE=BD=CF=89=CF=81=
=CE=B9=CF=83=CF=84=CE=B9=CE=BA=CF=8C =CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=
=CE=B1=CF=83=CE=BC=CE=BF=CF=8D|=CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C=CF=82 =
=CE=BB=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=BC=CE=BF=CF=8D|=CE=BB=
=CE=BF=CE=B3=CE=B1=CF=81=CE=B9=CE=B1=CF=83=CE=BC=CF=8C=CF=82 =CE=BC=CE=B5 =
=CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C)</td>
</tr>
<tr>
<th colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTh">Exampl=
e:</th>
<td colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTd">000000=
0012300695</td>
</tr>
<tr>
<th class=3D"highlight-grey confluenceTh" data-highlight-colour=3D"grey" st=
yle=3D"text-align: left;">Credit Card Number</th>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
</tr>
<tr>
<th rowspan=3D"2" style=3D"text-align: left;" class=3D"confluenceTh">Routin=
g Number</th>
<td rowspan=3D"3" style=3D"text-align: left;" class=3D"confluenceTd">Greece=
 Routing Number matches a valid routing number combined with any of the fol=
lowing keywords within a proximity of 10 terms: =CE=B1=CF=81=CE=B9=CE=B8=CE=
=BC=CF=8C=CF=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=
=83=CE=B7=CF=82, #=CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=BA=CE=AE=CF=
=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=
=82, =CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=BA=CE=AE=CF=82 =CE=B4=CF=
=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82, =CF=84=CF=
=81=CE=B1=CF=80=CE=B5=CE=B6=CE=B9=CE=BA=CE=AE =CE=B4=CF=81=CE=BF=CE=BC=CE=
=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7, # =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=
=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82, #=CE=B4=CF=81=CE=BF=CE=BC=CE=BF=
=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82, =CE=B1=CF=81. =CE=B4=CF=81=CE=
=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82 (or) RTN.<span st=
yle=3D"color: rgb(23,43,77);"> (All terms case insensitive.)</span></td>
<td style=3D"text-align: left;" class=3D"confluenceTd">\d{9}</td>
<td rowspan=3D"3" style=3D"text-align: left;" class=3D"confluenceTd"><br></=
td>
</tr>
<tr>
<td colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTd">(?i)(?=
:=CE=B1=CF=81=CE=B9=CE=B8=CE=BC=CF=8C=CF=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=
=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82|\#?=CF=84=CF=81=CE=B1=CF=80=CE=
=B5=CE=B6=CE=B9=CE=BA=CE=AE=CF=82 =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=
=8C=CE=B3=CE=B7=CF=83=CE=B7=CF=82|=CF=84=CF=81=CE=B1=CF=80=CE=B5=CE=B6=CE=
=B9=CE=BA=CE=AE =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=
=83=CE=B7|\#? =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=CE=B7=CF=83=
=CE=B7=CF=82|=CE=B1=CF=81. =CE=B4=CF=81=CE=BF=CE=BC=CE=BF=CE=BB=CF=8C=CE=B3=
=CE=B7=CF=83=CE=B7=CF=82|RTN)(?:\b|(?&lt;=3D[.#])(?=3D\W|$))</td>
</tr>
<tr>
<th colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTh">Exampl=
e:</th>
<td colspan=3D"1" style=3D"text-align: left;" class=3D"confluenceTd">123456=
789</td>
</tr>
<tr>
<th class=3D"highlight-#0065ff confluenceTh" data-highlight-colour=3D"#0065=
ff" style=3D"text-align: left;">Business Number</th>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
</tr>
<tr>
<th class=3D"highlight-#0065ff confluenceTh" data-highlight-colour=3D"#0065=
ff" style=3D"text-align: left;">Company Number</th>
<td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
