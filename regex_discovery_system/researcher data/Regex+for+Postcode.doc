<body>
    <h1>Regex for Postcode</h1>
    <div class=3D"Section1">
        <div class=3D"table-wrap">
<table class=3D"wrapped confluenceTable">
<colgroup>
<col>
<col>
<col>
</colgroup>
<tbody>
<tr>
<th class=3D"confluenceTh">Countries</th>
<th colspan=3D"1" style=3D"text-align: center;" class=3D"confluenceTh">Desc=
ription</th>
<th class=3D"confluenceTh">Regex</th>
</tr>
<tr>
<th class=3D"confluenceTh">Austria</th>
<td rowspan=3D"3" class=3D"confluenceTd">Austria Postcode matches with Aust=
rian postcode combined with any of the following keywords within a proximit=
y of 10 terms: Adresse, Wohnsitz, Ort, Postleitzahl (or) PLZ. (All terms ca=
se insensitive.)</td>
<td class=3D"confluenceTd">\d{4}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:Adresse|Wohnsitz|Ort|Postleitzahl|PLZ)</t=
d>
</tr>
<tr>
<th class=3D"confluenceTh">Example:</th>
<td class=3D"confluenceTd">1234</td>
</tr>
<tr>
<th class=3D"confluenceTh">Belgium</th>
<td rowspan=3D"3" class=3D"confluenceTd">Belgium Postcode matches with <spa=
n class=3D"legacy-color-text-blue3">Belgian</span> postcode combined with a=
ny of the following keywords within a proximity of 10 terms: adres, verblij=
fplaats, woonplaats, postcode, postcodegebied, postnummers (or) postgebied.=
 (All terms case insensitive.)</td>
<td class=3D"confluenceTd">\d{4}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:adres|verblijfplaats|woonplaats|postcode|=
postcodegebied|postnummers|postgebied)</td>
</tr>
<tr>
<th class=3D"confluenceTh">Example:</th>
<td class=3D"confluenceTd">8500</td>
</tr>
<tr>
<th class=3D"highlight-grey confluenceTh" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : ">Bulgaria</th>
<td class=3D"highlight-grey confluenceTd" data-highlight-colour=3D"grey" ro=
wspan=3D"3" title=3D"Background color : ">Bulgaria Postcode matches with <s=
pan class=3D"legacy-color-text-blue3" title=3D"">Bulgarian</span> postcode =
combined with any of the following keywords within a proximity of 10 terms:=
 =D0=B0=D0=B4=D1=80=D0=B5=D1=81, =D0=BC=D0=B5=D1=81=D1=82=D0=BE=D0=B6=D0=B8=
=D0=B2=D0=B5=D0=B5=D0=BD=D0=B5, =D0=B3=D1=80=D0=B0=D0=B4, =D0=BA=D1=80=D0=
=B0=D0=BB=D1=81=D0=BA=D0=B0 =D0=BF=D0=BE=D1=89=D0=B0, =D0=BE=D1=82=D0=B2=D0=
=BE=D1=80=D0=B5=D0=BD =D0=BA=D0=BE=D0=B4, =D1=80=D0=B5=D0=B3=D0=B8=D0=BE=D0=
=BD =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=
=BE=D0=B4, =D0=B7=D0=BE=D0=BD=D0=B0 =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=
=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4, =D0=B0=D0=B4=D0=BC=D0=B8=D0=BD=
=D0=B8=D1=81=D1=82=D1=80=D0=B0=D1=82=D0=B8=D0=B2=D0=BD=D0=B0 =D0=B5=D0=B4=
=D0=B8=D0=BD=D0=B8=D1=86=D0=B0 =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=
=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4, =D1=81=D0=B5=D0=BA=D1=82=D0=BE=D1=80=
 =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=
=D0=B4 (or) =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=
=D0=B4. (All terms case insensitive.)</td>
<td class=3D"highlight-grey confluenceTd" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : ">\d{4}</td>
</tr>
<tr>
<th class=3D"highlight-grey confluenceTh" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : "><br></th>
<td class=3D"highlight-grey confluenceTd" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : ">(?i)(?:=D0=B0=D0=B4=D1=80=D0=B5=D1=81|=D0=BC=D0=
=B5=D1=81=D1=82=D0=BE=D0=B6=D0=B8=D0=B2=D0=B5=D0=B5=D0=BD=D0=B5|=D0=B3=D1=
=80=D0=B0=D0=B4|=D0=BA=D1=80=D0=B0=D0=BB=D1=81=D0=BA=D0=B0 =D0=BF=D0=BE=D1=
=89=D0=B0|=D0=BE=D1=82=D0=B2=D0=BE=D1=80=D0=B5=D0=BD =D0=BA=D0=BE=D0=B4|=D1=
=80=D0=B5=D0=B3=D0=B8=D0=BE=D0=BD =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=
=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4|=D0=B7=D0=BE=D0=BD=D0=B0 =D0=BF=D0=
=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4|=D0=
=B0=D0=B4=D0=BC=D0=B8=D0=BD=D0=B8=D1=81=D1=82=D1=80=D0=B0=D1=82=D0=B8=D0=B2=
=D0=BD=D0=B0 =D0=B5=D0=B4=D0=B8=D0=BD=D0=B8=D1=86=D0=B0 =D0=BF=D0=BE =D0=BF=
=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4|=D1=81=D0=B5=
=D0=BA=D1=82=D0=BE=D1=80 =D0=BF=D0=BE =D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=
=D0=BA=D0=B8 =D0=BA=D0=BE=D0=B4|=D0=BF=D0=BE=D1=89=D0=B5=D0=BD=D1=81=D0=BA=
=D0=B8 =D0=BA=D0=BE=D0=B4)</td>
</tr>
<tr>
<th class=3D"highlight-grey confluenceTh" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : ">Example:</th>
<td class=3D"highlight-grey confluenceTd" data-highlight-colour=3D"grey" ti=
tle=3D"Background color : ">1234</td>
</tr>
<tr>
<th class=3D"confluenceTh">Croatia</th>
<td rowspan=3D"3" class=3D"confluenceTd">Croatia Postcode matches with <spa=
n class=3D"legacy-color-text-blue3">Croatian</span> postcode combined with =
any of the following keywords within a proximity of 10 terms: adresa, prebi=
vali=C5=A1te, grad, po=C5=A1tanski broj, otvoreni kod, po=C5=A1tanski broj,=
 podru=C4=8Dje po=C5=A1tanskog broja, jedinica po=C5=A1tanskog broja, sekto=
r po=C5=A1tanskog broja (or) po=C5=A1tanski broj. (All terms case insensiti=
ve; diacritics are optional.)</td>
<td class=3D"confluenceTd">\d{5}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:adresa|prebivali[=C5=A1s]te|grad|po[=C5=
=A1s]tanski broj|otvoreni kod|po[=C5=A1s]tanski broj|podru[c=C4=8D]je po[=
=C5=A1s]tanskog broja|jedinica po[=C5=A1s]tanskog broja|sektor po[=C5=A1s]t=
anskog broja|po[=C5=A1s]tanski broj)</td>
</tr>
<tr>
<th class=3D"confluenceTh">Example:</th>
<td class=3D"confluenceTd">12345</td>
</tr>
<tr>
<th class=3D"confluenceTh">Cyprus</th>
<td rowspan=3D"3" class=3D"confluenceTd">Cyprus Postcode matches with <span=
 class=3D"legacy-color-text-blue3">Cyriot</span> postcode combined with any=
 of the following keywords within a proximity of 10 terms: =CE=B4=CE=B9=CE=
=B5=CF=8D=CE=B8=CF=85=CE=BD=CF=83=CE=B7, =CF=84=CF=8C=CF=80=CE=BF=CF=82 =CE=
=B4=CE=B9=CE=B1=CE=BC=CE=BF=CE=BD=CE=AE=CF=82, =CF=80=CF=8C=CE=BB=CE=B7, =
=CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B5=CE=AF=CE=BF, =CE=B1=
=CE=BD=CE=BF=CE=B9=CF=87=CF=84=CF=8C=CF=82 =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=
=CE=B1=CF=82, =CF=83=CF=85=CE=BD=CE=BF=CE=B9=CE=BA=CE=AF=CE=B1 =CF=84=CE=B1=
=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=CF=8E=
=CE=B4=CE=B9=CE=BA=CE=B1, =CF=80=CE=B5=CF=81=CE=B9=CE=BF=CF=87=CE=AE =CF=84=
=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=
=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1, =CE=B4=CE=B9=CE=B1=CE=BC=CE=AD=CF=81=CE=B9=
=CF=83=CE=BC=CE=B1 =CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=
=CE=BA=CE=BF=CF=8D =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1, =CF=84=CE=BF=CE=BC=
=CE=AD=CE=B1=CF=82 =CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=
=CE=BA=CE=BF=CF=8D =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1, =CF=84=CE=B1=CF=87=
=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=CE=BA=CF=8C=CF=82 =CE=BA=CF=8E=CE=B4=
=CE=B9=CE=BA=CE=B1=CF=82, adres, ikamet, konum, kraliyet postas=C4=B1, kod =
noktas=C4=B1 a=C3=A7=C4=B1k, posta kodu b=C3=B6lgesi, posta kodu alan=C4=B1=
, posta kodu birimi, posta kodu sekt=C3=B6r=C3=BC, posta kodu (or) posta. (=
All terms case insensitive; diacritics are optional.)</td>
<td class=3D"confluenceTd">\d{4}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:=CE=B4=CE=B9=CE=B5=CF=8D=CE=B8=CF=85=CE=
=BD=CF=83=CE=B7|=CF=84=CF=8C=CF=80=CE=BF=CF=82 =CE=B4=CE=B9=CE=B1=CE=BC=CE=
=BF=CE=BD=CE=AE=CF=82|=CF=80=CF=8C=CE=BB=CE=B7|=CF=84=CE=B1=CF=87=CF=85=CE=
=B4=CF=81=CE=BF=CE=BC=CE=B5=CE=AF=CE=BF|=CE=B1=CE=BD=CE=BF=CE=B9=CF=87=CF=
=84=CF=8C=CF=82 =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1=CF=82|=CF=83=CF=85=CE=
=BD=CE=BF=CE=B9=CE=BA=CE=AF=CE=B1 =CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=
=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1|=CF=
=80=CE=B5=CF=81=CE=B9=CE=BF=CF=87=CE=AE =CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=
=81=CE=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=
=B1|=CE=B4=CE=B9=CE=B1=CE=BC=CE=AD=CF=81=CE=B9=CF=83=CE=BC=CE=B1 =CF=84=CE=
=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=CF=
=8E=CE=B4=CE=B9=CE=BA=CE=B1|=CF=84=CE=BF=CE=BC=CE=AD=CE=B1=CF=82 =CF=84=CE=
=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=BC=CE=B9=CE=BA=CE=BF=CF=8D =CE=BA=CF=
=8E=CE=B4=CE=B9=CE=BA=CE=B1|=CF=84=CE=B1=CF=87=CF=85=CE=B4=CF=81=CE=BF=CE=
=BC=CE=B9=CE=BA=CF=8C=CF=82 =CE=BA=CF=8E=CE=B4=CE=B9=CE=BA=CE=B1=CF=82|adre=
s|ikamet|konum|kraliyet postas=C4=B1|kod noktas=C4=B1 a=C3=A7=C4=B1k|posta =
kodu b[o=C3=B6]lgesi|posta kodu alan=C4=B1|posta kodu birimi|posta kodu sek=
t[o=C3=B6]r=C3=BC|posta kodu|posta)</td>
</tr>
<tr>
<th class=3D"confluenceTh">Example:</th>
<td class=3D"confluenceTd">1000</td>
</tr>
<tr>
<th class=3D"confluenceTh">Czech</th>
<td rowspan=3D"3" class=3D"confluenceTd">Czech Postcode matches with Czech =
postcode combined with any of the following keywords within a proximity of =
10 terms: adresa, m=C3=ADsto pobytu, m=C4=9Bsto, st=C3=A1tn=C3=AD po=C5=A1t=
a, otev=C5=99en=C3=BD k=C3=B3d, =C4=8Dtvr=C5=A5 PS=C4=8D, oblast PS=C4=8D, =
jednotka PS=C4=8D, sektor PS=C4=8D (or) PS=C4=8D. (All terms case insensiti=
ve; diacritics are optional.)</td>
<td class=3D"confluenceTd">\d{3}[ ]\d{2}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:adresa|m[i=C3=AD]sto pobytu|m[=C4=9Be]sto=
|st[=C3=A1a]tn[i=C3=AD] po[=C5=A1s]ta|otev[=C5=99r]en[=C3=BDy] k[=C3=B3o]d|=
[c=C4=8D]tvr[=C5=A5t] PS[c=C4=8D]|oblast PS[c=C4=8D]|jednotka PS[c=C4=8D]|s=
ektor PS[c=C4=8D]|PS[c=C4=8D])</td>
</tr>
<tr>
<th class=3D"confluenceTh">Example:</th>
<td class=3D"confluenceTd">115 05</td>
</tr>
<tr>
<th class=3D"confluenceTh">Denmark</th>
<td rowspan=3D"3" class=3D"confluenceTd">Denmark Postcode matches with <spa=
n class=3D"legacy-color-text-blue3">Danish</span>&nbsp;postcode combined wi=
th any of the following keywords within a proximity of 10 terms: adresse, b=
op=C3=A6l, by (or) postnummer. (All terms case insensitive; diacritics are =
optional.)</td>
<td class=3D"confluenceTd">\d{4}</td>
</tr>
<tr>
<th class=3D"confluenceTh"><br></th>
<td class=3D"confluenceTd">(?i)(?:adresse|bop[ae=C3=A6]l|by|postnummer)</td=
>
</tr>
